generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  
}

enum Role {
  ADMIN
  PUBLISHER
  READER
  AUTHOR   
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?  // nullable because we might have OAuth later, but for now we'll set it
  name         String?
  role         Role     @default(READER)
  
   emailVerified DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  publisher    Publisher?
  author Author?  
  cart         Cart?    // one-to-one with Cart
  purchases    Purchase[]
  reviews Review[]
 contactUnlocks ContactUnlock[]
 passwordResetTokens PasswordResetToken[]
 verificationTokens VerificationToken[]
}

model VerificationToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Publisher {
  id         String   @id @default(uuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  approved   Boolean  @default(false) // admin must approve before they can publish
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  email              String?
  phone              String?
  nidPath     String?
  selfiePath  String?   
verificationStatus VerificationStatus @default(PENDING) 
  books      Book[]
}

model Author {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  bio                String?
  email              String
  phone              String?
  nidUrl     String?
  selfieUrl  String?
  nidPath     String?
  selfiePath  String?
  verificationStatus VerificationStatus @default(PENDING)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  books              Book[]
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  UNPAID
  PAID
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  books     Book[]
}

model Book {
  id            String       @id @default(uuid())
  title         String
  authorName    String        @default("") 
  authorId      String?
  description   String?
  price         Decimal      @db.Decimal(10,2)
  coverImageUrl String?
  pdfStoragePath String?
  status        BookStatus   @default(PENDING)
  publishedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  publisherId   String
  publisher     Publisher    @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  categoryId    String
  category      Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  author        Author?      @relation(fields: [authorId], references: [id])
  
  cartItems     CartItem[]
  purchaseItems PurchaseItem[]
  reviews       Review[]
  paymentStatus PaymentStatus @default(UNPAID)
}

model ContactUnlock {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId   String
  profileType String   // "AUTHOR" or "PUBLISHER"
  unlockedAt  DateTime @default(now())

  @@unique([userId, profileId, profileType])
}

enum BookStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

// Cart and CartItem
model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(uuid())
  quantity  Int      @default(1)
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, bookId]) // prevent duplicate book in same cart
}

// Purchase and PurchaseItem
model Purchase {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchasedAt DateTime @default(now())
  totalAmount Decimal  @db.Decimal(10,2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       PurchaseItem[]
}

model PurchaseItem {
  id         String   @id @default(uuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  bookId     String
  book       Book     @relation(fields: [bookId], references: [id], onDelete: Restrict)
  priceAtPurchase Decimal @db.Decimal(10,2) // snapshot of the book's price
  quantity   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  rating    Int
  text      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, bookId])
}